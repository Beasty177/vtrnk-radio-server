server {
    listen 80;
    server_name vtrnk.online;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name vtrnk.online;
    ssl_certificate /etc/letsencrypt/live/vtrnk.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vtrnk.online/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 300M;
    root /home/beasty197/projects/vtrnk_radio/web;
    index radio.html;
    access_log /var/log/nginx/vtrnk_access.log;
    error_log /var/log/nginx/vtrnk_error.log warn;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:5001/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 3600s;
        keepalive_timeout 3600s;
        access_log /var/log/nginx/socket_io.log;
    }

    location = /upload_radio_show {
        proxy_pass http://127.0.0.1:5001/upload_radio_show;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_method POST;
        client_max_body_size 300M;
        add_header Access-Control-Allow-Origin "*";
        add_header Access-Control-Allow-Methods "POST, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type";
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        access_log /var/log/nginx/upload_radio_show.log;
        error_log /var/log/nginx/upload_radio_show_error.log debug;
    }

    location = /upload_track {
        proxy_pass http://127.0.0.1:5001/upload_track;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_method POST;
        client_max_body_size 300M;
        add_header Access-Control-Allow-Origin "*";
        add_header Access-Control-Allow-Methods "POST, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type";
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        access_log /var/log/nginx/upload_track.log;
        error_log /var/log/nginx/upload_track_error.log debug;
    }

    location = /delete_radio_show {
        proxy_pass http://127.0.0.1:5001/delete_radio_show;
